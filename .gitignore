# Python
__pycache__/
*.py[cod]
.venv/
venv/
build-venv/
*.egg-info/
.pytest_cache/

# Local / runtime data (every user has their own)
state/
logs/
captures/
obs_output/
video_output/
config.toml
*.damaged-*.json

# Research / test media and generated analysis (large; never commit)
samples/
analysis_output/
*.mp4
*.mkv
*.mov
*.wav
*.npz

# Builds
build/
dist/
build_out/
*.spec
*.zip

# Signing keys belong outside this repository (packaging/sign_release.py refuses them here); this is a second safeguard
*.pem
*.key

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.log

# Small committed test inputs (pop-up box masks of real cases, tests/test_cases.py)
!tests/fixtures/popups/*.npz
